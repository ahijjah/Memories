    "@memory-app/ai": "*",
    "@memory-app/domain": "*",
    "@nestjs-modules/ioredis": "^2.2.2",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.15.0",
    "class-transformer": "^0.5.1",
