{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "lib": ["ES2021"],
    "paths": {
      "@memory-app/ai": ["../../packages/ai/src/index.ts"],
      "@memory-app/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["../../packages/**", "node_modules", "dist", "prisma"]
}

