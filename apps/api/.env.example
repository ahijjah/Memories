# Copy to .env and fill in for local development.
# Never commit the real .env file (see .gitignore).

# Postgres (matches infra/docker-compose.yml defaults)
DATABASE_URL="postgresql://memory_app:memory_app_dev_password@localhost:5432/memory_app_dev?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# AI provider (see packages/ai) — Anthropic Claude
ANTHROPIC_API_KEY=

# Object storage (S3-compatible: point to local MinIO for dev, or AWS S3/R2 for prod)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=memory-app-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

PORT=3000
NODE_ENV=development
